<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FD">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_ai_settings"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="1dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Build AI Settings"
        app:titleTextColor="#111827" />
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API Configuration"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/et_ai_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:hint="API Key"
                android:inputType="textPassword"
                android:textColor="#111827"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/et_ai_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:hint="Model Name (e.g. glm-4.6)"
                android:textColor="#111827"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/et_ai_base_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:hint="Base URL (Optional)"
                android:textColor="#111827"
                android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_ai_settings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Save Settings"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#534AEF"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
